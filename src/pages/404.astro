---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found · ROSHAI" description="The page requested does not exist." path="/404" noindex>
  <main id="main" class="notfound">
    <div class="wrap">
      <p class="eyebrow">Error 404</p>
      <h1>Page not found.</h1>
      <p>The address does not match a page on this site.</p>
      <div class="actions"><a class="btn" href="/">Return to the ROSHAI home page</a></div>
    </div>
  </main>
</Base>
