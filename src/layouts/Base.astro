---
import '../styles/global.css';
interface Props { title: string; description: string; theme?: 'violet' | 'paper'; path?: string; jsonld?: object[]; noindex?: boolean }
const { title, description, theme = 'violet', path = '/', jsonld = [], noindex = false } = Astro.props;
const canonical = new URL(path, 'https://roshai.co').href;
const ogImage = 'https://roshai.co/og.png';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en" data-theme={theme === 'paper' ? 'paper' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={theme === 'paper' ? '#f6f5fb' : '#2d0196'} />
    <link rel="icon" type="image/png" sizes="32x32" href={base + '/favicon-32.png'} />
    <link rel="apple-touch-icon" href={base + '/apple-touch-icon.png'} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ROSHAI" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
